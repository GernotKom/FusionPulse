{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "fusionpulse",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-23",
  "assets": { "directory": "./public", "binding": "ASSETS" },

  "observability": { "enabled": true, "head_sampling_rate": 1 },

  /* v4.0.3 · DIE EINZIGE HARTE BREMSE, DIE ES GIBT.
     Budget-Alerts bei Cloudflare sind ausdruecklich nur informativ — sie
     schicken eine Mail und deckeln NICHTS. Der Workers-Paid-Plan rechnet
     Ueberschreitungen automatisch ab, ohne Rueckfrage. Die einzige Stelle, an
     der sich eine durchgedrehte Schleife wirklich stoppen laesst, ist die
     CPU-Zeit je Aufruf.
     30 Sekunden sind bewusst nicht knapp gewaehlt: der schwerste Job
     (Whole-Market-Radar, ~11 MB JSON ranken) soll nicht mitsterben. Der Wert
     wirkt trotzdem, weil Cron-Trigger sonst bis zu 15 MINUTEN CPU ziehen
     duerfen — das ist der Faktor 30, um den ein Amoklauf hier billiger wird.
     Nach ein paar Tagen im Dashboard die tatsaechliche CPU-Zeit ablesen und
     den Wert auf das Doppelte des beobachteten Maximums nachziehen. */
  "limits": { "cpu_ms": 30000 },

  // Nur Diagnose. Die verbindliche Version steht in src/version.js und wird
  // von scripts/sync-version.mjs aus package.json hierher gespiegelt.
  "vars": { "APP_VERSION": "4.0.3", "ALPACA_FEED": "iex", "TIINGO_STOCKS_MODE": "primary" },

  // v3.2: Cron läuft jede Minute. Im Worker selbst wird gedrosselt:
  // Krypto 5-minütig, Alpaca im Opening-Fenster, Aktien-Learning im Primary-Modus über Tiingo.
  "triggers": { "crons": ["* * * * *"] },

  // Cloudflare Wrangler >=4.45 kann D1 beim Deploy automatisch provisionieren.
  // Das Binding ist im Worker als env.DB verfügbar. Die Tabellen werden in
  // v3.0 beim ersten Zugriff per CREATE TABLE IF NOT EXISTS initialisiert.
  "d1_databases": [{
    "binding": "DB",
    "database_name": "fusionpulse-learning",
    "database_id": "4c63a0fd-d478-46b9-bf6a-e904bbbd738e",
    "migrations_dir": "migrations"
  }]

  // Optional weiterhin möglich:
  // "kv_namespaces": [{ "binding": "SNAP", "id": "<KV_NAMESPACE_ID>" }]
}
