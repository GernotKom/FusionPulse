{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "fusionpulse",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-23",
  "assets": { "directory": "./public", "binding": "ASSETS" },
  "vars": { "APP_VERSION": "2.4.0" },

  // Cron wärmt den Snapshot-Cache vor. Keine limits-Konfiguration:
  // der Workers-Free-Plan akzeptiert keine benutzerdefinierten CPU-Limits.
  "triggers": { "crons": ["* * * * *"] }

  // Optional später:
  // "kv_namespaces": [{ "binding": "SNAP", "id": "<KV_NAMESPACE_ID>" }]
}
