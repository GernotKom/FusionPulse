{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "fusionpulse",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-23",
  "assets": { "directory": "./public", "binding": "ASSETS" },

  "observability": { "enabled": true, "head_sampling_rate": 1 },

  /* ══ v4.5.2 · WIEDER EINGESCHALTET — DER TARIF IST JETZT PAID ═════════════
     Der Block war seit v4.0.5 auskommentiert, weil der Free-Plan ihn ablehnt
     ("CPU limits are not supported for the Free plan" [code: 100328]) und drei
     Versionen lang jeden Deploy gekillt hat. Auf Workers Paid ist er erlaubt —
     und dort ist er kein Komfort mehr, sondern die einzige Obergrenze, die es
     ueberhaupt noch gibt: Free WEIST AB, Paid RECHNET AB.

     Nachgerechnet, weil eine Zahl ohne Rechnung nur eine Meinung ist.
     Der Cron laeuft minuetlich, also bis zu 44.640 Aufrufe im 31-Tage-Monat.
     Enthalten sind 30 Mio. CPU-Millisekunden, jede weitere Million 0,02 USD.

       ohne Block   Cron-Trigger duerfen 15 MINUTEN CPU ziehen (900.000 ms).
                    Schlimmster Fall: 44.640 x 900.000 = 40,2 Mrd. CPU-ms.
                    Das sind rund 803.000 USD. Nicht als Prognose gemeint,
                    sondern als Groessenordnung dessen, was oben offen steht.
       cpu_ms 5000  44.640 x 5.000 = 223 Mio. CPU-ms, davon 193 Mio. ueber dem
                    Kontingent: rund 3,87 USD. Der schlimmste Fall bleibt damit
                    unter 9 USD im Monat statt unbegrenzt.
       Normalbetrieb Der schwerste Job (Whole-Market-Radar, ~11,2 MB JSON
                    parsen und ranken) liegt bei geschaetzt 0,5-2 s und laeuft
                    nach RADAR_CADENCE_MIN rund 70-mal am Tag, nicht minuetlich.
                    5.000 ms lassen ihm den Faktor 2,5 bis 10.

     Wird der Radar doch abgeschnitten, steht das als Fehler im Log — ein
     abgebrochener Lauf ist SICHTBAR, eine Rechnung erst am Monatsende. Deshalb
     lieber zu eng und nachjustieren als zu weit und hoffen.

     subrequests 1000 ist auf Paid ohnehin die Vorgabe; der Eintrag macht sie
     nur explizit. Wichtig bleibt sie trotzdem: Wartezeit auf fetch(), KV oder
     D1 zaehlt NICHT zur CPU-Zeit. Eine Schleife, die Millionen Zeilen nach D1
     schreibt, verbraucht fast keine CPU und liefe am CPU-Deckel vorbei — jede
     D1-Abfrage ist aber ein Subrequest. Der Cron liegt mit ~150 weit darunter.

     ZURUECKNEHMEN, falls der Deploy mit 100328 scheitert: dann laeuft das
     Konto doch noch auf Free, und dort wird das ganze Feld abgelehnt. */
  "limits": { "cpu_ms": 5000, "subrequests": 1000 },

  // Nur Diagnose. Die verbindliche Version steht in src/version.js und wird
  // von scripts/sync-version.mjs aus package.json hierher gespiegelt.
  //
  // D1_WRITE_BUDGET (v4.2.1): selbst gesetzte Tagesobergrenze für GESCHRIEBENE
  // ZEILEN. Cloudflare bietet für D1 keine Ausgabenbremse — Budget-Alerts
  // informieren, sie halten nichts an. Diese Zahl ist die einzige Bremse.
  //
  //   Free : 100.000/Tag ist Cloudflares eigenes Limit. 90.000 lässt Reserve,
  //          weil die Eigenmessung eine UNTERGRENZE ist (.first()-Abfragen
  //          werden nicht gezählt) und die Bremse deshalb zu spät greift.
  //   Paid : enthalten sind 50 Mio./Monat, also rund 1.667.000/Tag. Ein Wert
  //          um 1.500.000 bleibt sicher darunter. Darüber kostet jede weitere
  //          Million 1 USD, ohne Rückfrage.
  //
  // Ohne diesen Eintrag gilt die Vorgabe 90.000. Vor einem Wechsel auf Paid
  // erst eine saubere Tagesmessung abwarten, dann diesen Wert setzen, dann
  // den Tarif wechseln — in dieser Reihenfolge.
  "vars": { "APP_VERSION": "4.5.4", "ALPACA_FEED": "iex", "TIINGO_STOCKS_MODE": "primary", "D1_WRITE_BUDGET": "1000000", "CF_PLAN": "paid" },

  // v3.2: Cron läuft jede Minute. Im Worker selbst wird gedrosselt:
  // Krypto 5-minütig, Alpaca im Opening-Fenster, Aktien-Learning im Primary-Modus über Tiingo.
  "triggers": { "crons": ["* * * * *"] },

  // Cloudflare Wrangler >=4.45 kann D1 beim Deploy automatisch provisionieren.
  // Das Binding ist im Worker als env.DB verfügbar. Die Tabellen werden in
  // v3.0 beim ersten Zugriff per CREATE TABLE IF NOT EXISTS initialisiert.
  "d1_databases": [{
    "binding": "DB",
    "database_name": "fusionpulse-learning",
    "database_id": "4c63a0fd-d478-46b9-bf6a-e904bbbd738e",
    "migrations_dir": "migrations"
  }]

  // Optional weiterhin möglich:
  // "kv_namespaces": [{ "binding": "SNAP", "id": "<KV_NAMESPACE_ID>" }]
}
